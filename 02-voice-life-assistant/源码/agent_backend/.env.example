# This file is an example only; the service reads process environment variables.
# Start safely with mock (always NO_OP). Set openai only with an actual vision model.
VISION_PROVIDER=mock
VISION_MODEL=
OPENAI_API_KEY=
REQUEST_TIMEOUT_SECONDS=15
ENABLE_DEBUG_LOGGING=false
# Optional shared bearer token. Configure the same token on the Android NextAction panel.
AGENT_API_TOKEN=
