# 默认使用模拟模式；不调用真实模型，也不需要 API Key。
# PORT 未设置时使用 8000；Render 自动注入 PORT，无需手动设置。
PORT=8000
# 同源首页不需要 CORS。独立前端填写真实 origin，逗号分隔，无路径、无末尾斜杠。
# 示例：https://frontend.example.com,http://localhost:5173
CORS_ALLOW_ORIGINS=
UPLOAD_DIR=uploads
AI_MODE=mock

# /upload 保存图片的保留时间与清理周期（秒），均必须大于0。
UPLOAD_RETENTION_SECONDS=30
UPLOAD_CLEANUP_INTERVAL_SECONDS=5
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_API_KEY=
AI_TIMEOUT_SECONDS=25
AI_OUTPUT_FORMAT=json_schema

# 使用真实 OpenAI 兼容服务时，设置 AI_MODE=openai_compatible 并填写 AI_API_KEY。
# 其他服务商请覆盖 AI_BASE_URL、AI_MODEL 与 AI_API_KEY。

# 独立视觉线；保留原 AI_* 配置。真实方舟配置见 README。
VISION_MODE=mock
VISION_PROVIDER=ark
VISION_OUTPUT_FORMAT=json_object
VISION_TIMEOUT_SECONDS=25
# VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# VISION_MODEL=填写方舟控制台支持视觉输入的模型ID或推理接入点ID
# ARK_API_KEY=仅在本地.env填写

# 新增双 Agent 接口专用配置；独立于原 AI_*、VISION_* 视觉线和腾讯 OCR。
# 未配置服务令牌时，两个新接口返回503，不允许匿名访问。
VISION_API_TOKEN=
VISION_QWEN_BASE_URL=https://api.siliconflow.cn/v1
VISION_QWEN_API_KEY=
VISION_QWEN_MODEL=Qwen/Qwen3-VL-8B-Instruct
VISION_QWEN_TIMEOUT=120

# 多功能助手（新增入口），不改变独立 OCR 服务配置。
ASSISTANT_OCR_BASE_URL=https://medicine-vision-ocr.onrender.com
# 可选：仅在服务端设置；留空则用户在页面输入 OCR 访问令牌。
ASSISTANT_OCR_TOKEN=
